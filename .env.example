APP_NAME=Foodpecker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://foodpecker.test

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

# Server: APP_ENV=production, APP_DEBUG=false, APP_URL=https://… (public address,
# invitation links are built from it). Behind a reverse proxy (nginx on Plesk,
# load balancer, `herd share`) list its IPs or use "*":
# TRUSTED_PROXIES=127.0.0.1

FOODPECKER_INVITATIONS_EXPIRES_DAYS=14
FOODPECKER_PLATFORM_FEE_PERCENT=1.0
# Login form prefill, only used with APP_ENV=local:
FOODPECKER_DEMO_OWNER_EMAIL=marie@foodpecker.test
FOODPECKER_DEMO_OWNER_PASSWORD=password

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Locally mails end up in storage/logs/laravel.log. On a server use smtp and
# check the setup with `php artisan app:send-test-mail you@example.com`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="post@foodpecker.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Deployment (read by deploy.php on your machine, not needed on the server):
# DEPLOY_HOST=foodpecker.example.org
# DEPLOY_USER=plesk-user
# DEPLOY_PATH=~/httpdocs
# DEPLOY_PHP=/opt/plesk/php/8.3/bin/php
# DEPLOY_SSH_KEY=~/.ssh/foodpecker_ed25519
